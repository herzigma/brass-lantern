# Copy to .env and fill in only the providers you use.

# --- Grue server (REST API) ---
GRUE_URL=http://localhost:8081
# GRUE_API_KEY=            # only if the server was started with GRUE_API_KEYS

# --- LLM providers (spec: provider:model) ---
OPENROUTER_API_KEY=        # openrouter:<vendor/model>, reports real dollar cost
# OPENAI_API_KEY=          # openai:<model>; also used with --base-url for OpenAI-compatible servers
# ANTHROPIC_API_KEY=       # anthropic:<model> (ANTHROPIC_BASE_URL is intentionally ignored; use --base-url)
# GEMINI_API_KEY=          # gemini:<model>
# ollama: needs no key (http://localhost:11434/v1)

# Optional: HTTP-Referer sent to OpenRouter (app attribution)
# OPENROUTER_REFERER=
