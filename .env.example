# Required: Your LLM provider API key
AI_API_KEY=your-api-key-here

# Grue server WebSocket URI (default: ws://localhost:8080)
GRUE_URI=ws://localhost:8080

# AI provider: openai | anthropic | gemini (default: openai)
AI_PROVIDER=openai

# Optional: Model override (uses provider default if unset)
# AI_MODEL=gpt-4o
